* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 20px;
    color: #333;
}

header {
    text-align: center;
    padding: 30px;
    background: rgba(255,255,255,0.95);
    border-radius: 15px;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

h1 {
    color: #667eea;
    font-size: 2.5em;
}

.subtitle {
    color: #888;
    font-style: italic;
    margin-top: 10px;
}

main {
    max-width: 600px;
    margin: 0 auto;
}

section {
    background: rgba(255,255,255,0.95);
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 20px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

h2 {
    color: #764ba2;
    margin-bottom: 15px;
    border-bottom: 2px solid #eee;
    padding-bottom: 10px;
}

ul {
    list-style: none;
    padding: 0;
}

li {
    padding: 8px 0;
    font-size: 1.1em;
}

input[type="text"] {
    padding: 12px 20px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    width: 60%;
    outline: none;
    transition: border-color 0.3s;
}

input[type="text"]:focus {
    border-color: #667eea;
}

button {
    padding: 12px 25px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}

button:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
}

#output {
    margin-top: 15px;
    font-size: 1.3em;
    color: #667eea;
    font-weight: bold;
}

footer {
    text-align: center;
    padding: 20px;
    color: rgba(255,255,255,0.8);
}
